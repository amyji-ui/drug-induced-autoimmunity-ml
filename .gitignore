# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/
env/

# Generated output: every script rewrites these, so tracking them
# causes merge conflicts whenever two people run the same step.
logs/
*.joblib
*.pkl
*.npy

# Fitted pipelines are large binaries, regenerable by rerunning the model's script.
# results/*.csv IS tracked: one small file per model, written by one person each.
results/pipelines/

# Notebooks
.ipynb_checkpoints/
*.nbconvert.ipynb

# OS and editor
.DS_Store
.vscode/
.idea/
*.swp

# Note: data/ is deliberately NOT ignored. The CSVs are ~460 KB total
# and the project is not reproducible without them.
